# TOTP secret — generate with: node -e "import('otplib').then(m => console.log(m.generateSecret()))"
# Add the otpauth:// URI to your password manager as a TOTP entry
TOTP_SECRET=YOUR_BASE32_SECRET_HERE

# Base URL this app is accessed from (used to build WebAuthn rpID and origins)
PUBLIC_URL=http://localhost:4321

# Override rpID if needed (defaults to hostname extracted from PUBLIC_URL)
# RP_ID=localhost

# Extra origins to accept for WebAuthn (comma-separated, no spaces)
# ALLOWED_ORIGINS=https://lifeos.localhost,https://lifeos.wolfdivided

# Session cookie signing secret — never change once set
SESSION_SECRET=generate-a-long-random-string-here
