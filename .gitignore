# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# headless claude refresh runs (lock + captured output)
src/content/**/.refresh-lock
src/content/**/.refresh-log

# grocery micro-agent runs (locks, logs, transient agent output)
src/content/grocery/.*-lock
src/content/grocery/.*-log
src/content/grocery/.categorized.json
src/content/grocery/.scan-results.json
src/content/grocery/cart-request.json


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# WebAuthn passkey data (instance-specific)
data/

# Settings > Logins — encrypted secrets, retailer Chrome profiles, job scratch
src/content/settings/secrets.json.enc
src/content/settings/.profiles/
src/content/settings/.job-*
src/content/settings/.probe-*

# claude code session worktrees
.claude/worktrees/

# test infrastructure (sandboxed content copies, playwright artifacts)
.test-sandbox/
test-results/
playwright-report/
tests/e2e/.auth/
tests/qa/.artifacts/
