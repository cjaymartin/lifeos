---
import type { WidgetDef } from '@/lib/widgets';

interface Props {
  w: WidgetDef;
}
const { w } = Astro.props;

const style =
  w.config.style === 'warning' ? 'bg-warning-subtle border-warning-border' :
  w.config.style === 'success' ? 'bg-emerald-500/10 border-emerald-500/40' :
  'bg-card border-border';
---

{w.config.content && (
  <div class={`rounded-xl border p-5 ${style}`}>
    {w.label && (
      <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-2">
        {w.label}
      </p>
    )}
    <p class="text-sm text-foreground">{String(w.config.content)}</p>
  </div>
)}
