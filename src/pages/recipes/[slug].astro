---
import AppLayout from '@/layouts/AppLayout.astro';
import RecipeDetail from '@/components/RecipeDetail';
import { readFile } from 'fs/promises';
import { vaultPath } from '@/lib/content-paths';
import { parseNote, noteStem } from '@/lib/markdown-store';
import type { RecipeSection } from '@/components/RecipeDetail';

const { slug } = Astro.params;

interface RecipeMeta {
  title: string;
  source: string;
  servings: number;
  prepTime: string;
  cookTime: string;
  tags: string[];
  dateAdded: string;
  image?: string;
}

/** "brown-sugar-creami" → "Brown Sugar Creami" — title fallback for hand notes. */
const titleize = (stem: string): string =>
  stem.replace(/-+/g, ' ').replace(/\b\w/g, c => c.toUpperCase()).trim() || 'Untitled';

/** Split a Markdown body into `## `-headed sections (the recipe's steps/ingredients). */
function parseSections(body: string): RecipeSection[] {
  const sections: RecipeSection[] = [];
  for (const part of body.split(/^## /m)) {
    if (!part.trim()) continue;
    const nl = part.indexOf('\n');
    if (nl === -1) continue;
    sections.push({ heading: part.slice(0, nl).trim(), content: part.slice(nl + 1).trim() });
  }
  return sections;
}

// The filename is the recipe's identity ([slug].md). A recipe hand-authored in
// Obsidian just works — no frontmatter required. Missing fields degrade to
// readable defaults (title ← titleized filename) rather than 404ing the note.
let recipe: RecipeMeta | null = null;
let sections: RecipeSection[] = [];

try {
  const raw = await readFile(vaultPath('recipes', `${slug}.md`), 'utf-8');
  const { data, body } = parseNote<Partial<RecipeMeta>>(raw);
  recipe = {
    title: (data.title ?? '').toString().trim() || titleize(noteStem(slug ?? '')),
    source: (data.source ?? '').toString(),
    servings: Number(data.servings) || 0,
    prepTime: (data.prepTime ?? '').toString(),
    cookTime: (data.cookTime ?? '').toString(),
    tags: Array.isArray(data.tags) ? data.tags : [],
    dateAdded: (data.dateAdded ?? '').toString(),
    image: data.image,
  };
  sections = parseSections(body);
} catch {}

if (!recipe) return Astro.redirect('/recipes');
---
<AppLayout title={recipe.title}>
  <div class="p-6 md:p-10 max-w-3xl mx-auto space-y-10">

    <a href="/recipes" class="text-xs text-muted-foreground hover:text-foreground transition-colors print:hidden">
      ← Recipes
    </a>

    <RecipeDetail
      title={recipe.title}
      prepTime={recipe.prepTime}
      cookTime={recipe.cookTime}
      servings={recipe.servings}
      tags={recipe.tags}
      source={recipe.source}
      sections={sections}
      image={recipe.image}
      client:load
    />

  </div>
</AppLayout>
