---
import AppLayout from '@/layouts/AppLayout.astro';
import { readdir, readFile } from 'fs/promises';
import { join } from 'path';

interface Recipe {
  title: string;
  slug: string;
  tags: string[];
  prepTime: string;
  cookTime: string;
  servings: number;
  dateAdded: string;
  source: string;
}

function parseFrontmatter(raw: string): Recipe | null {
  const match = raw.match(/^---\n([\s\S]*?)\n---/);
  if (!match) return null;
  const data: Record<string, unknown> = {};
  for (const line of match[1].split('\n')) {
    const colon = line.indexOf(': ');
    if (colon === -1) continue;
    const key = line.slice(0, colon).trim();
    const val = line.slice(colon + 2).trim();
    if (val.startsWith('[')) {
      try { data[key] = JSON.parse(val); } catch { data[key] = []; }
    } else if (val.startsWith('"') && val.endsWith('"')) {
      data[key] = val.slice(1, -1);
    } else if (val !== '' && !isNaN(Number(val))) {
      data[key] = Number(val);
    } else {
      data[key] = val;
    }
  }
  return data as unknown as Recipe;
}

const contentDir = join(process.cwd(), 'src/content/recipes');
let recipes: Recipe[] = [];
try {
  const files = (await readdir(contentDir)).filter(f => f.endsWith('.md'));
  const parsed = await Promise.all(
    files.map(async f => {
      const raw = await readFile(join(contentDir, f), 'utf-8');
      return parseFrontmatter(raw);
    })
  );
  recipes = (parsed.filter(Boolean) as Recipe[])
    .sort((a, b) => b.dateAdded.localeCompare(a.dateAdded));
} catch {}

const title = 'Recipes';
---
<AppLayout title={title}>
  <div class="p-6 md:p-10 max-w-5xl mx-auto space-y-6">
    <h1 class="text-2xl font-semibold text-foreground">{title}</h1>

    {recipes.length === 0 ? (
      <p class="text-sm text-muted-foreground">No recipes yet.</p>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recipes.map(r => (
          <a href={`/recipes/${r.slug}`}
             class="group rounded-lg border border-border bg-card p-5 space-y-3 hover:bg-accent/30 transition-colors">
            <p class="font-medium text-foreground group-hover:text-foreground leading-snug">{r.title}</p>
            <div class="flex flex-wrap gap-1">
              {r.tags?.map(tag => (
                <span class="text-xs px-2 py-0.5 rounded-full bg-muted text-muted-foreground">{tag}</span>
              ))}
            </div>
            <div class="flex gap-4 text-xs text-muted-foreground">
              {r.prepTime && <span>Prep: {r.prepTime}</span>}
              {r.cookTime && <span>Cook: {r.cookTime}</span>}
              {r.servings && <span>{r.servings} serving{r.servings !== 1 ? 's' : ''}</span>}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</AppLayout>
