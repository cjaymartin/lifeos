---
import AppLayout from '@/layouts/AppLayout.astro';
import { stacks } from '@/features';
import RefreshButton from '@/components/RefreshButton';
import { getSnapshot } from '@/features/tasks/ops/store';
import { ensureSyncLoop, getSyncStatus } from '@/features/tasks/ops/sync-loop';
import { loadDeliveries } from '@/features/deliveries/ops';
import { selectWidgets, type DailyData, type WidgetDef } from '@/lib/widgets';
import { readNote } from '@/lib/markdown-store';
import { vaultPath } from '@/lib/content-paths';
import { readFile } from 'fs/promises';
import { join } from 'path';

// Widget render adapters — adding a widget type is one component + one map
// entry; shared card chrome (incl. the corner link icon) lives in WidgetCard.
import TrashWidget from '@/features/daily/widgets/TrashWidget.astro';
import WeatherWidget from '@/features/daily/widgets/WeatherWidget.astro';
import StatWidget from '@/features/daily/widgets/StatWidget.astro';
import NoteCardWidget from '@/features/daily/widgets/NoteCardWidget.astro';
import CalendarWidget from '@/features/daily/widgets/CalendarWidget.astro';
import BriefingWidget from '@/features/daily/widgets/BriefingWidget.astro';
import NoteFullWidget from '@/features/daily/widgets/NoteFullWidget.astro';
import DeliveriesWidget from '@/features/deliveries/widgets/DeliveriesWidget.astro';
import TasksWidgetCard from '@/features/tasks/widgets/TasksWidgetCard.astro';
import BirthdayWidget from '@/features/daily/widgets/BirthdayWidget.astro';
import WaterDeliveryWidget from '@/features/daily/widgets/WaterDeliveryWidget.astro';
import { describeBirthdays, birthdaysToday } from '@/lib/birthdays';
import { daysUntil, WATER_WARNING_DAYS } from '@/lib/widgets';

/* eslint-disable @typescript-eslint/no-explicit-any */
const CARD_RENDERERS: Record<string, any> = {
  trash: TrashWidget,
  weather: WeatherWidget,
  deliveries: DeliveriesWidget,
  tasks: TasksWidgetCard,
  stat: StatWidget,
  note: NoteCardWidget,
  birthday: BirthdayWidget,
  'water-delivery': WaterDeliveryWidget,
};
const FULL_RENDERERS: Record<string, any> = {
  calendar: CalendarWidget,
  briefing: BriefingWidget,
  note: NoteFullWidget,
};

// Load widget registry
let registry: { widgets: WidgetDef[] } = { widgets: [] };
try {
  const raw = await readFile(join(process.cwd(), 'src/content/widgets/registry.json'), 'utf-8');
  registry = JSON.parse(raw);
} catch {}

// Load daily data — the morning briefing is a single vault note (frontmatter).
const dailyNote = await readNote<DailyData>(vaultPath('daily', 'today.md'));
const daily: DailyData | null = dailyNote?.data ?? null;

// Load deliveries (own file + own sync lifecycle — not part of today.json)
const deliveriesData = await loadDeliveries();
const deliveries = deliveriesData?.deliveries ?? [];

// Date helpers
const now = new Date();
const dateLabel = now.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
const dayOfWeek = daily?.date
  ? new Date(daily.date + 'T12:00:00').getDay()
  : now.getDay();

const { cards: cardWidgets, fulls: fullWidgets } = selectWidgets(registry.widgets, {
  daily,
  deliveriesCount: deliveries.length,
  dayOfWeek,
  now,
});

// Trash banner — any visible trash widget whose condition is met
const trashWidget = [...cardWidgets, ...fullWidgets].find(w => w.type === 'trash');
const showTrashBanner = !!trashWidget && !!daily?.trash;
const isTrashDay = dayOfWeek === 3;

// Birthday banner — only on the day itself (per owner decision). Computed live
// against the local date so it lights up exactly on the birthday.
const birthdayWidget = [...cardWidgets, ...fullWidgets].find(w => w.type === 'birthday');
const todayStr = now.toLocaleDateString('en-CA'); // YYYY-MM-DD, local
const birthdaysNow = birthdayWidget
  ? birthdaysToday(describeBirthdays(daily?.birthdays ?? [], todayStr))
  : [];
const birthdayNames = birthdaysNow.map(b => b.name).join(', ');

// Water-delivery warning banner — only inside the 5-day window, and only if the
// water widget is actually visible (it owns the 14-day display condition).
const waterWidget = [...cardWidgets, ...fullWidgets].find(w => w.type === 'water-delivery');
const waterDays = waterWidget && daily?.water ? daysUntil(daily.water.nextDate, now) : null;
const showWaterBanner = waterDays !== null && waterDays >= 0 && waterDays <= WATER_WARNING_DAYS;
const waterWhen = waterDays === 0 ? 'TODAY' : waterDays === 1 ? 'tomorrow' : `in ${waterDays} days`;

// Grid class based on visible card count
const gridCols = cardWidgets.length <= 1 ? 'md:grid-cols-1'
               : cardWidgets.length === 2 ? 'md:grid-cols-2'
               : 'md:grid-cols-3';

const dashboardStacks = stacks.filter(s => s.dashboardWidget);

// Live tasks mirror — initial data for the Tasks widget island (kept fresh via SSE)
ensureSyncLoop();
const tasksInitial = { ...(await getSnapshot()), sync: getSyncStatus() };

// One props bag for every adapter; each takes what it needs.
const widgetProps = { daily, deliveries, tasksInitial, isTrashDay };
---

<AppLayout title="Dashboard">
  <div class="min-h-full">

    {/* ── Trash banner ─────────────────────────────────────────────────── */}
    {showTrashBanner && (
      <div class={`border-b px-6 py-3 flex items-center gap-3 ${
        isTrashDay ? 'bg-warning-subtle border-warning-border' : 'bg-card border-border'
      }`}>
        <svg class={`w-5 h-5 shrink-0 ${isTrashDay ? 'text-warning' : 'text-muted-foreground'}`}
             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
          <path d="M10 11v6M14 11v6"/>
          <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
        </svg>
        {isTrashDay ? (
          <span class="text-sm font-semibold text-warning">
            Trash{daily?.trash?.recycling ? ' + Recycling' : ''} goes out TODAY
            {daily?.trash?.note ? ` — ${daily.trash.note}` : ' — put it out by 7 AM'}
          </span>
        ) : (
          <span class="text-sm text-muted-foreground">
            Trash{daily?.trash?.recycling ? ' + Recycling' : ''} day: <strong class="text-foreground">Wednesday</strong>
          </span>
        )}
      </div>
    )}

    {/* ── Birthday banner (only on the day) ────────────────────────────── */}
    {birthdaysNow.length > 0 && (
      <div class="border-b border-warning-border bg-warning-subtle px-6 py-3 flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0 text-warning" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"/>
          <path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"/>
          <path d="M2 21h20"/>
          <path d="M7 8v2M12 8v2M17 8v2"/>
          <path d="M7 4h.01M12 4h.01M17 4h.01"/>
        </svg>
        <span class="text-sm font-semibold text-warning">
          🎂 {birthdayNames}{birthdaysNow.length > 1 ? ' have' : ' has'} a birthday TODAY
        </span>
      </div>
    )}

    {/* ── Water delivery banner (inside the 5-day window) ───────────────── */}
    {showWaterBanner && (
      <div class="border-b border-warning-border bg-warning-subtle px-6 py-3 flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0 text-warning" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
        </svg>
        <span class="text-sm font-semibold text-warning">
          💧 Water delivery ({daily?.water?.vendor}) arrives {waterWhen}
        </span>
      </div>
    )}

    <div class="p-6 md:p-10 space-y-6 max-w-5xl mx-auto">

      {/* ── Header ──────────────────────────────────────────────────────── */}
      <div class="flex items-start justify-between gap-4">
        <div class="space-y-0.5">
          <p class="text-sm text-muted-foreground">{dateLabel}</p>
          <h1 class="text-2xl font-semibold text-foreground">
            {daily?.greeting ?? 'Good morning.'}
          </h1>
        </div>
        <RefreshButton client:load />
      </div>

      {/* ── Card row ────────────────────────────────────────────────────── */}
      {cardWidgets.length > 0 && (
        <div class={`grid grid-cols-1 gap-4 ${gridCols}`}>
          {cardWidgets.map(w => {
            const Renderer = CARD_RENDERERS[w.type];
            return Renderer ? <Renderer w={w} {...widgetProps} /> : null;
          })}
        </div>
      )}

      {/* ── Full-width widgets ───────────────────────────────────────────── */}
      {fullWidgets.map(w => {
        const Renderer = FULL_RENDERERS[w.type];
        return Renderer ? <Renderer w={w} {...widgetProps} /> : null;
      })}

      {/* ── Stacks (additive, at bottom) ────────────────────────────────── */}
      {dashboardStacks.length > 0 && (
        <section class="space-y-3 pt-4 border-t border-border">
          <h2 class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Stacks</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
            {dashboardStacks.map(stack => (
              <a href={stack.href}
                 class="group rounded-lg border border-border bg-card p-4 space-y-1 hover:bg-accent/30 transition-colors">
                <p class="text-sm font-medium text-foreground">{stack.label}</p>
                {stack.description && (
                  <p class="text-xs text-muted-foreground">{stack.description}</p>
                )}
              </a>
            ))}
          </div>
        </section>
      )}

      {/* ── Empty state ──────────────────────────────────────────────────── */}
      {!daily && (
        <div class="rounded-xl border border-dashed border-border p-10 text-center space-y-2">
          <p class="text-sm font-medium text-foreground">No briefing yet</p>
          <p class="text-xs text-muted-foreground">
            Run <code class="font-mono bg-muted px-1 rounded">/populate-daily</code> to generate today's briefing.
          </p>
        </div>
      )}

    </div>
  </div>
</AppLayout>
