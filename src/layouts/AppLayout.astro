---
import '@/styles/globals.css';
import Sidebar from '@/components/Sidebar';
import ChatSidebar from '@/components/ChatSidebar';
import { stacks } from '@/lib/stacks';

interface Props {
  title?: string;
}

const { title = 'LifeOS' } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
const currentStack = stacks.find(s => currentPath === s.href || currentPath.startsWith(s.href + '/'));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — LifeOS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400..600&display=swap" />
    <!-- Prevent FOUC: apply theme class before first paint -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme') ?? 'dark';
        document.documentElement.classList.add(t);
      } catch {}
    </script>
  </head>
  <body class="flex h-screen overflow-hidden bg-background text-foreground">
    <Sidebar stacks={stacks} currentPath={currentPath} client:load />
    <main class="flex-1 overflow-y-auto">
      <slot />
    </main>
    {currentStack && (
      <ChatSidebar stackId={currentStack.id} stackLabel={currentStack.label} client:load />
    )}
  </body>
</html>
